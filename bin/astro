#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Keep kitty itself unmodified; this desktop identity belongs to Astro.
# Kitty dispatches utilities before parsing window options.
case "${1-}" in
    +*|@) exec kitty "$@" ;;
esac

# Inspect only Kitty's option prefix; function arguments leave launch argv intact.
# Operand aliases are checked against Kitty 0.49.2's native option definitions.
information_call() {
    help_info=0
    version_info=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --) break ;;
            --help=no|--help=false|--help=n|-h=no|-h=false|-h=n) help_info=0; shift ;;
            --version=no|--version=false|--version=n|-v=no|-v=false|-v=n) version_info=0; shift ;;
            --help|--help=y|--help=yes|--help=true|-h) help_info=1; shift ;;
            --version|--version=y|--version=yes|--version=true|-v) version_info=1; shift ;;
            --help=*|--version=*|--replay-commands|--replay-commands=*) return 0 ;;
            --class|--app-id|--name|--os-window-tag|--title|-T|--config|-c|--override|-o|--directory|--working-directory|-d|--detached-log|--session|--instance-group|--listen-on|--start-as|--position|--dump-bytes|--watcher)
                [ "$#" -ge 2 ] || return 0
                shift 2 ;;
            --class=*|--app-id=*|--name=*|--os-window-tag=*|--title=*|-T=*|--config=*|-c=*|--override=*|-o=*|--directory=*|--working-directory=*|-d=*|--detached-log=*|--session=*|--instance-group=*|--listen-on=*|--start-as=*|--position=*|--dump-bytes=*|--watcher=*) shift ;;
            --detach|--detach=*|--hold|--hold=*|--single-instance|--single-instance=*|-1|--wait-for-single-instance-window-close|--wait-for-single-instance-window-close=*|--grab-keyboard|--grab-keyboard=*|--dump-commands|--dump-commands=*|--debug-rendering|--debug-rendering=*|--debug-gl|--debug-gl=*|--debug-input|--debug-input=*|--debug-keyboard|--debug-keyboard=*|--debug-font-fallback|--debug-font-fallback=*|--execute|--execute=*|-e) shift ;;
            --*) return 0 ;; # Let Kitty reject unknown flags without copying.
            -?*)
                # Native short groups apply an operand only to the final flag.
                short=${1#-}
                short=${short%%=*}
                case "$short" in *[!1eTcodhv]*) return 0 ;; esac
                prefix=${short%?}
                # Value-less -c/-o list options in a short cluster prefix trigger
                # a native parser SIGSEGV in Kitty 0.49.2; never seed the clipboard.
                case "$prefix" in *[co]*) return 0 ;; esac
                case "$prefix" in *h*) help_info=1 ;; esac
                case "$prefix" in *v*) version_info=1 ;; esac
                last=${short#"${short%?}"}
                case "$last" in
                    h|v)
                        # Only the last short alias gets an explicit operand.
                        # A later false assignment can negate an earlier flag.
                        case "$1" in
                            *=n|*=no|*=false) info=0 ;;
                            *=y|*=yes|*=true) info=1 ;;
                            *=*) return 0 ;;
                            *) info=1 ;;
                        esac
                        if [ "$last" = h ]; then help_info=$info; else version_info=$info; fi
                        shift ;;
                    T|c|o|d)
                        case "$1" in
                            *=*) shift ;;
                            *) [ "$#" -ge 2 ] || return 0; shift 2 ;;
                        esac ;;
                    *) shift ;;
                esac ;;
            *) break ;; # Everything after the program name belongs to the program.
        esac
    done
    [ "$help_info" -eq 1 ] || [ "$version_info" -eq 1 ]
}
if information_call "$@"; then exec kitty "$@"; fi

# Seed both selections once per app start, never on each tab/pane or prompt.
# Never let a missing or stuck clipboard service prevent opening the terminal.
copy_with_deadline() {
    # GNU coreutils is standard on the supported Ubuntu installation. Without
    # it, skip clipboard initialization rather than run an unbounded helper.
    command -v timeout >/dev/null 2>&1 || return 1
    # Only positive decimal seconds (optional s), at most 30 seconds and six
    # fractional digits. This excludes zero, underflow, infinity and huge waits
    # without requiring another interpreter on the terminal's startup path.
    duration=${ASTRO_CLIPBOARD_TIMEOUT:-2}
    duration=${duration%s}
    [ "${#duration}" -le 32 ] || return 1
    case "$duration" in ''|*[!0-9.]*|*.*.*) return 1 ;; esac
    case "$duration" in *[1-9]*) ;; *) return 1 ;; esac
    whole=${duration%%.*}
    fraction=''
    case "$duration" in *.*) fraction=${duration#*.} ;; esac
    [ "${#fraction}" -le 6 ] || return 1
    while :; do
        case "$whole" in 0*) whole=${whole#0} ;; *) break ;; esac
    done
    [ "${#whole}" -le 2 ] || return 1
    whole=${whole:-0}
    [ "$whole" -le 30 ] || return 1
    if [ "$whole" -eq 30 ]; then
        case "$fraction" in *[1-9]*) return 1 ;; esac
    fi
    timeout --kill-after=0.2 -- "$duration" "$@"
}

if [ -n "${WAYLAND_DISPLAY-}" ]; then
    if command -v clipboard-copy >/dev/null 2>&1; then
        printf '%s' '/resume' | copy_with_deadline clipboard-copy >/dev/null 2>&1 || :
    elif command -v wl-copy >/dev/null 2>&1; then
        printf '%s' '/resume' | copy_with_deadline wl-copy --type 'text/plain;charset=utf-8' >/dev/null 2>&1 || :
        printf '%s' '/resume' | copy_with_deadline wl-copy --primary --type 'text/plain;charset=utf-8' >/dev/null 2>&1 || :
    fi
elif command -v xclip >/dev/null 2>&1; then
    printf '%s' '/resume' | copy_with_deadline xclip -selection clipboard >/dev/null 2>&1 || :
    printf '%s' '/resume' | copy_with_deadline xclip -selection primary >/dev/null 2>&1 || :
fi
exec kitty --class=astro --name=astro --title=Astro "$@"
